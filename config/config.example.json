{
  "accounts": {
    "revolut/current-eur": {
      "parser": "revolut-current",
      "currency": "EUR",
      "wealthfolioAccountId": "",
      "includeOpeningBalance": true,
      "transferRules": [
        {"pattern": "(?:desde|a|from|to) EUR Ahorro", "targetAccount": "revolut/savings-eur", "mirror": true}
      ]
    },
    "revolut/stocks": {
      "parser": "revolut-stocks",
      "currency": "USD",
      "wealthfolioAccountId": ""
    },
    "revolut/savings-eur": {
      "parser": "revolut-savings",
      "currency": "EUR",
      "symbol": "REV-CASH-EUR",
      "isin": "IE000AZVL3K0",
      "wealthfolioAccountId": "",
      "externalTransfers": true,
      "amountOverrides": {}
    },
    "revolut/savings-usd": {
      "parser": "revolut-savings",
      "currency": "USD",
      "symbol": "REV-CASH-USD",
      "isin": "IE000H9J0QX4",
      "wealthfolioAccountId": "",
      "amountOverrides": {}
    },
    "xtb/main": {
      "parser": "xtb",
      "currency": "EUR",
      "wealthfolioAccountId": "",
      "tickerAliases": {
        "CSPX.UK": "CSPX.L"
      },
      "tickerCurrencies": {
        "CSPX.UK": "USD"
      }
    },
    "sabadell/principal": {
      "parser": "sabadell",
      "currency": "EUR",
      "wealthfolioAccountId": "",
      "includeOpeningBalance": true,
      "transferRules": [
        {
          "pattern": "^TRASPASO(?: A)? \\d{4}-\\d{8}-\\d{2}\\b",
          "targetAccount": "sabadell/ahorros",
          "mirror": false
        },
        {
          "pattern": "^TARJETA CREDITO\\b",
          "targetAccount": "sabadell/tarjeta",
          "mirror": true
        }
      ]
    },
    "sabadell/ahorros": {
      "parser": "sabadell",
      "currency": "EUR",
      "wealthfolioAccountId": "",
      "includeOpeningBalance": true
    },
    "sabadell/tarjeta": {
      "parser": "sabadell-card",
      "currency": "EUR",
      "wealthfolioAccountId": ""
    }
  }
}
